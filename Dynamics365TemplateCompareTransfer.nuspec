<?xml version="1.0"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Dynamics365TemplateCompareTransfer</id>
    <version>1.2026.1.2</version>
    <title>Dynamics 365 Template Compare &amp; Transfer</title>
    <authors>Adrian Lucaci</authors>
    <owners>Adrian Lucaci</owners>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <license type="file">LICENSE</license>
    <icon>Assets\DocumentsTemplateMoverIcon80.png</icon>
    <iconUrl>https://raw.githubusercontent.com/Lucarian77/Dynamics365TemplateCompareTransfer/main/Assets/DocumentsTemplateMoverIcon80.png</iconUrl>
    <projectUrl>https://github.com/Lucarian77/Dynamics365TemplateCompareTransfer</projectUrl>
    <repository type="git" url="https://github.com/Lucarian77/Dynamics365TemplateCompareTransfer.git" />
    <description>Compare and safely transfer Word and Excel document templates between Microsoft Dataverse environments. Includes normalized package comparison, separate copy and update operations, dry run, duplicate and same-environment protection, newer-target warnings, status preservation, post-write verification, CSV evidence export, and detailed diagnostics.</description>
    <summary>Compare and safely transfer Dataverse Word and Excel document templates.</summary>
    <releaseNotes>Initial public release with Word and Excel template comparison, safe source-to-target copy and update workflows, dry run, duplicate and same-environment safeguards, newer-target warnings, status preservation, post-write verification, automatic refresh, CSV evidence export, detailed diagnostics, and accessible row selection.</releaseNotes>
    <copyright>Copyright © Adrian Lucaci 2026</copyright>
    <tags>XrmToolBox Dynamics365 Dynamics 365 Dataverse PowerPlatform ALM DocumentTemplate Templates Word Excel Compare Transfer Migration Deployment</tags>
    <dependencies>
      <group targetFramework=".NETFramework4.8">
        <dependency id="XrmToolBox" version="[1.2025.7.71,)" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
  <files>
    <file src="bin\Release\Dynamics365TemplateCompareTransfer.dll" target="lib\net48\Plugins" />
    <file src="Assets\DocumentsTemplateMoverIcon80.png" target="Assets" />
    <file src="LICENSE" target="" />
  </files>
</package>

